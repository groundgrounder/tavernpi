{
  "name": "tavernpi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "spike:m0": "node packages/app/spike/08-m0-demo.ts",
    "spike:m1": "node packages/app/spike/09-m1-story-db.ts",
    "spike:01": "node packages/app/spike/01-hello.ts",
    "spike:02": "node packages/app/spike/02-resource-takeover.ts",
    "spike:03": "node packages/app/spike/03-tool-whitelist.ts",
    "spike:04": "node packages/app/spike/04-parallel-memory.ts",
    "spike:05": "node packages/app/spike/05-navigate-tree.ts",
    "spike:06": "node packages/app/spike/06-sqlite-backup.ts",
    "spike:07": "node packages/app/spike/07-compaction.ts",
    "typecheck": "tsc -p packages/core/tsconfig.json && tsc -p packages/app/tsconfig.json",
    "test": "node --test \"packages/core/test/**/*.test.ts\"",
    "m1:cli": "node packages/app/src/m1-cli.ts",
